{
  "name": "@aiursoft/autodark.js",
  "version": "1.2.3",
  "description": "Auto dark theme",
  "module": "dist/esm/autodark.js",
  "types": "dist/types/autodark.d.ts",
  "scripts": {
    "clean": "rm -rf ./dist",
    "build-css": "sass --style=compressed --source-map src/autodark.scss dist/css/autodark.min.css",
    "build-js": "tsc -b ./tsconfig.json ./tsconfig.types.json",
    "build": "npm run build-css && npm run build-js",
    "format": "prettier --write .",
    "lint": "eslint src/ --ext .ts && prettier --check .",
    "check": "npm run lint && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AiursoftWeb/autodark.js"
  },
  "dependencies": {
    "bootstrap": "^4.6.2"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.1",
    "sass": "^1.108.1",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3"
  },
  "author": "Anduin Xue <anduin@aiursoft.com>",
  "license": "MIT",
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.5"
    }
  }
}
